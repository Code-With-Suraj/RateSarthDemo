{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "/admin/(.*)\\.html", "dest": "/frontend/admin/$1.html" },
    { "src": "/admin/(.*)", "dest": "/frontend/admin/$1.html" },
    { "src": "/admin", "dest": "/frontend/admin/dashboard.html" },
    { "src": "/vendor/(.*)\\.html", "dest": "/frontend/vendor/$1.html" },
    { "src": "/vendor/(.*)", "dest": "/frontend/vendor/$1.html" },
    { "src": "/vendor", "dest": "/frontend/vendor/portal.html" },
    { "src": "/css/(.*)", "dest": "/frontend/css/$1" },
    { "src": "/js/(.*)", "dest": "/frontend/js/$1" },
    { "src": "/login", "dest": "/frontend/login.html" },
    { "src": "/", "dest": "/frontend/index.html" }
  ]
}
